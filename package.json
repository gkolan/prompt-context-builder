{
  "name": "prompt-context-builder",
  "private": true,
  "version": "1.0.3",
  "description": "Build deterministic, security-enforced Salesforce prompts from record context.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "lint": "eslint \"force-app/main/default/lwc/**/*.js\"",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage -- --runInBand --no-cache && node scripts/check-lwc-coverage.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:screenshots": "node scripts/check-screenshot-contract.mjs",
    "check:agent-guidance": "node scripts/check-agent-guidance.mjs",
    "check:language": "node scripts/check-plain-language.mjs",
    "check:common-entry": "node scripts/check-common-entry.mjs",
    "check:day-one": "node scripts/check-day-one-contract.mjs",
    "check:input-log": "node scripts/check-input-log-contract.mjs",
    "check:file-input": "node scripts/check-file-input-contract.mjs",
    "check:match-bulk": "node scripts/check-match-bulk-contract.mjs",
    "check:release": "node scripts/check-public-release.mjs",
    "check:permissions": "node scripts/check-permission-contract.mjs",
    "check:field-descriptions": "node scripts/check-field-descriptions.mjs",
    "check:namespace-fixtures": "node scripts/check-namespace-fixtures.mjs",
    "check:test-data-isolation": "node scripts/check-test-data-isolation.mjs",
    "demo:setup-source": "sf apex run --file scripts/apex/seedVerificationTemplates.apex",
    "demo:verify-source": "sf apex run --file scripts/apex/verifyVerificationTemplates.apex",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "ci:gates": "npm run prettier:verify && npm run check:docs && npm run check:screenshots && npm run check:agent-guidance && npm run check:language && npm run check:common-entry && npm run check:day-one && npm run check:input-log && npm run check:file-input && npm run check:match-bulk && npm run check:release && npm run check:permissions && npm run check:field-descriptions && npm run check:namespace-fixtures && npm run check:test-data-isolation && npm run lint && npm run test:unit:coverage",
    "prepare": "husky || true",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
