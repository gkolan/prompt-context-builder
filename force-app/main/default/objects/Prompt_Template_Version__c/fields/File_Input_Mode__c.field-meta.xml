<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>File_Input_Mode__c</fullName>
    <description
  >Preserves the published choice for whether this prompt version uses Salesforce Files.</description>
    <inlineHelpText
  >This published value shows whether files are disabled, selected by the user, or automatically selected.</inlineHelpText>
    <label>File Input Mode</label>
    <required>true</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value><fullName>DISABLED</fullName><default>true</default><label
        >Disabled</label></value>
            <value><fullName>USER_SELECT</fullName><default
        >false</default><label>User Selects Files</label></value>
            <value><fullName>ALL_ELIGIBLE</fullName><default
        >false</default><label>All Eligible Files</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
